# Botchain interactive-terminal session image.
#
# One long-lived container is spawned per terminal session (see terminal.rs).
# This image is a complete rootfs so the sandboxed shell "feels like Linux":
# nano/vim render with full terminfo, /etc/* is present, DNS + HTTPS egress
# work natively (no manual bwrap binds). Built once by setup.sh, reused.
#
# Tag: botchain-terminal:latest
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash nano vim-tiny python3 python3-pip nodejs curl wget ca-certificates \
      ncurses-term coreutils procps less manpages \
      git openssh-client \
 && rm -rf /var/lib/apt/lists/*

# ncurses-term provides the full xterm-256color terminfo entry (used by nano/vim/top).

ENV TERM=xterm-256color \
    COLORTERM=truecolor \
    SHELL=/bin/bash \
    LANG=C.UTF-8 \
    PS1="bash-5.2$ "

WORKDIR /workspace

CMD ["/bin/bash", "-i"]
