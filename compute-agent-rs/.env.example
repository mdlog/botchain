# BotCompute Rust provider agent — .env example
# Copy to .env and fill in your values.

PROVIDER_PRIVATE_KEY=0x_your_private_key_here
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
AGENT_PORT=3006

# Browser origins allowed to call this agent, comma-separated, no trailing slash.
# The agent URL is published on-chain, so leave this as tight as possible.
# Unset falls back to local dev origins only.
AGENT_ALLOWED_ORIGINS=http://localhost:3000

# Contract addresses — BOT Chain Testnet (chain id 968).
# Must match contracts/deployments.json; anything set here overrides the
# defaults compiled into chain.rs.
REGISTRY_ADDR=0xcBbEa600C8d15E190A1C69676d8b8a5938BFE396
MARKETPLACE_ADDR=0xB72A69BeFFcd478e2ae19C20b65b1cAC1DC5d848
