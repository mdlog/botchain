# ──────────────────────────────────────────────────────────
#  BotCompute — environment template
#  Copy to `.env` and fill in real values:  cp .env.example .env
#  `.env` is gitignored. Keep it mode 600 — it holds a live API key.
# ──────────────────────────────────────────────────────────
#
# Vite only bundles VITE_*-prefixed variables into the browser. Everything
# without that prefix is read by the dev/preview server (vite-ai-proxy.ts) and
# never reaches the client, which is why the AI keys below are unprefixed.

# ── AI pricing engine (server-side only) ─────────────────
# The SERVER decides which provider is used — the browser cannot override it.
# "openai" or "gemini".
AI_PROVIDER="gemini"

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-2.5-flash"

# OpenAI — https://platform.openai.com/api-keys  (used when AI_PROVIDER="openai")
# OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OPENAI_MODEL="gpt-4.1-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"     # Azure / OpenRouter / local
#
# The proxy only accepts models from its own allowlist and rate-limits per
# client, but it still spends your key. `npm run dev` binds to localhost; pass
# `npm run dev -- --host` only when you actually want it on the network.
#
# The proxy runs in `vite dev` and `vite preview`. A static `vite build` served
# from a CDN has no /api/ai route and the app falls back to heuristic pricing —
# mount `handleAiRequest` from vite-ai-proxy.ts in a serverless function to run
# AI pricing in a real deployment.

# ── Chain selection (client) ─────────────────────────────
# "testnet" → BOT Chain Testnet (968), the proving ground.
# "mainnet" → BOT Chain (677). Only selectable once DEPLOYMENTS[677] in
# src/config/chain.ts is filled in; otherwise the app fails at load instead of
# silently reading zero addresses.
VITE_CHAIN="testnet"

# ── Dev server ───────────────────────────────────────────
# Comma-separated hostnames allowed to reach the dev/preview server through a
# tunnel (Cloudflare, ngrok, Codespaces). Leave empty for local-only.
# DEV_ALLOWED_HOSTS="my-tunnel.trycloudflare.com"

# Set to "true" to disable HMR (useful behind some tunnels).
# DISABLE_HMR="false"
