{
  "name": "botcompute-contracts",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "sync-abis": "hardhat run scripts/sync-abis.ts",
    "seed:demo": "hardhat run scripts/seed-demo.ts --network botchain-testnet",
    "attest": "hardhat run scripts/attest.ts --network botchain-testnet",
    "attest:mainnet": "hardhat run scripts/attest.ts --network botchain-mainnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network botchain-testnet",
    "verify:testnet": "hardhat verify --network botchain-testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network botchain-mainnet",
    "seed:demo:mainnet": "hardhat run scripts/seed-demo.ts --network botchain-mainnet",
    "verify:mainnet": "hardhat verify --network botchain-mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.14.0",
    "dotenv": "^16.6.1",
    "hardhat": "^2.22.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.13.0"
  }
}
