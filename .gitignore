# Dependencies
node_modules/

# Build output
dist/
coverage/
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# Rust build artifacts.
# Cargo.lock is intentionally NOT ignored: compute-agent-rs is a binary crate,
# and committing its lockfile is what makes provider installs reproducible.
compute-agent-rs/target/

# Environment — never commit real keys. Use the .env.example templates.
.env
.env.local
.env.*.local

# Private keys / certificates
*.pem
*.key
.wallet/

# Provider agent runtime state
agent.log
tunnel.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
