# ── BotCompute Provider CLI ──────────────────────────────
# Copy to .env and fill in your values, then: chmod 600 .env
#
# .env holds a private key in plaintext. setup.sh writes it with mode 600; if
# you create this file by hand, do the same. Never commit it.

# Provider wallet private key (with 0x prefix)
PROVIDER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# BOT Chain Testnet. This release is testnet-only — there is no mainnet
# deployment, so do not point these at chain 677.
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Contract addresses — must match contracts/deployments.json for CHAIN_ID above.
# These change on every redeploy; copy them from deployments.json rather than
# trusting this file to be current.
REGISTRY_ADDR=0xcBbEa600C8d15E190A1C69676d8b8a5938BFE396
MARKETPLACE_ADDR=0xB72A69BeFFcd478e2ae19C20b65b1cAC1DC5d848
ORACLE_ADDR=0x1087701623e187D00cF05A77DFA08F2710FB66Aa
AGENT_REGISTRY_ADDR=0xBF0Fb1508B9E9A6FF13FE74991aA54789D31cAE7

# Port the Rust compute agent listens on; the tunnel publishes this port.
AGENT_PORT=3006
