# ── ComputeRWA Provider CLI ──────────────────────────────
# Copy to .env and fill in your values

# Provider wallet private key (with 0x prefix)
PROVIDER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoint (testnet or mainnet)
# Testnet:  https://rpc.bohr.life   (chainId 968)
# Mainnet:  https://rpc.botchain.ai  (chainId 677)
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Contract addresses (from deployments.json — already deployed)
REGISTRY_ADDR=0x1476b38108ca44A550b780dc7223a48488b83309
MARKETPLACE_ADDR=0xb873AB623A0387974b6DC8a95da503deAB1313a7
ORACLE_ADDR=0xe106ba1671d6c0C7DDfEc7386d426CA800339D42
